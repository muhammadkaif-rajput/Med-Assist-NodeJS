      </a>
      <a href="/admin/manage-symptoms" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm <%= activePage === 'manage-symptoms' ? 'font-bold bg-gradient-to-r from-cyan-500/20 to-blue-600/20 border border-cyan-500/30 text-white shadow-[0_0_15px_rgba(6,182,212,0.2)]' : 'font-semibold text-gray-400 hover:bg-white/5' %> transition">
