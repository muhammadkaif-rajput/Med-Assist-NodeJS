<aside class="w-full md:w-64 glass md:min-h-screen flex flex-col shrink-0 relative z-10 border-r border-white/5">
  <div class="px-6 py-5 border-b border-white/5 flex items-center gap-3">
      <div class="w-8 h-8 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-lg flex items-center justify-center font-bold">
        <i class="fas fa-heartbeat text-sm"></i>
      </div>
      <span class="font-bold text-lg tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
  </div>
  <div class="p-6 pb-2">
    <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1">Admin Info</p>
    <p class="font-bold text-white truncate text-sm"><%= userName %></p>
  </div>
  <nav class="flex-1 px-4 py-4 space-y-2">
      <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm <%= activePage === 'dashboard' ? 'font-bold bg-gradient-to-r from-cyan-500/20 to-blue-600/20 border border-cyan-500/30 text-white shadow-[0_0_15px_rgba(6,182,212,0.2)]' : 'font-semibold text-gray-400 hover:bg-white/5' %> transition">
