<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pill Tracker | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; } .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(6,182,212,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 left-0 w-[50%] h-[50%] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 right-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-prescription-bottle-medical text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-patient') %>

    <!-- RIGHT CONTENT -->
    <main class="flex-1 space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
              <h2 class="text-2xl font-extrabold text-white">Daily Pill Tracker</h2>
              <p class="text-xs text-gray-400 mt-1">Manage and track your medication routine schedules.</p>
          </div>
      </div>

      <% if (message) { %>
          <div class="bg-green-500/10 border border-green-500/30 text-green-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-check-circle mr-2"></i> <%= message %>
          </div>
      <% } %>
      <% if (error) { %>
          <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
          </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- ADD MEDICINE FORM -->
          <div class="glass p-6 rounded-3xl border border-white/5 shadow-lg h-fit space-y-6">
              <div>
                  <h3 class="text-md font-bold text-white tracking-wide"><i class="fas fa-plus-circle text-cyan-400 mr-2"></i>Add Medicine</h3>
                  <p class="text-[10px] text-gray-500 mt-1 uppercase tracking-widest">Create a new schedule</p>
              </div>

              <form method="POST" action="/patient/medicines" class="space-y-4">
                  <div>
                      <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Medicine Name</label>
                      <input type="text" name="medicine_name" required placeholder="e.g. Panadol, Metformin" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                  </div>
                  <div>
                      <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Dosage / Quantity</label>
                      <input type="text" name="dosage" required placeholder="e.g. 1 Tablet, 5ml Syrup" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                  </div>
                  <div>
                      <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Time of Day</label>
                      <select name="time_of_day" required class="w-full bg-slate-900 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                          <option value="Morning">Morning</option>
                          <option value="Afternoon">Afternoon</option>
                          <option value="Night">Night</option>
                          <option value="As Needed">As Needed</option>
                      </select>
                  </div>
                  <div>
                      <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Relation to Food</label>
                      <select name="relation_to_food" required class="w-full bg-slate-900 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                          <option value="After Meal">After Meal</option>
                          <option value="Before Meal">Before Meal</option>
                          <option value="During Meal">During Meal</option>
                          <option value="Empty Stomach">Empty Stomach</option>
                      </select>
                  </div>

                  <button type="submit" name="add_medicine" value="1" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold py-3 rounded-xl transition text-xs uppercase tracking-widest shadow-[0_0_15px_rgba(6,182,212,0.3)]">
                      Add to Routine
                  </button>
              </form>
          </div>

          <!-- MEDICINE LIST & LOG STATE -->
          <div class="lg:col-span-2 space-y-6">
              <div class="glass rounded-3xl overflow-hidden border border-white/5 shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
                  <div class="px-6 py-5 border-b border-white/10 bg-white/5 flex justify-between items-center">
                      <h3 class="font-bold text-white tracking-wide"><i class="fas fa-calendar-day text-cyan-400 mr-2"></i>Medication Intake Today (
                        <%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) %>
                      )</h3>
                      <span class="text-[10px] text-gray-500 uppercase tracking-widest font-mono"><%= medicines.length %> Prescribed</span>
                  </div>

                  <div class="p-6 space-y-4">
                      <% if (medicines.length === 0) { %>
                          <div class="p-12 text-center text-gray-500 text-xs font-mono">No medicine schedules set up yet. Use the form on the left to add one!</div>
                      <% } else { %>
                          <div class="grid grid-cols-1 gap-4">
                              <% medicines.forEach(function(med) { 
                                  let bgClass = "bg-white/5 hover:border-white/10";
                                  let statusText = "Not Taken";
                                  let iconClass = "fa-clock text-gray-400";
                                  
                                  if (med.today_status === 'Taken') {
                                      bgClass = "bg-green-500/5 border-green-500/20 hover:border-green-500/40";
                                      statusText = "Taken";
                                      iconClass = "fa-check-circle text-green-400 animate-pulse";
                                  } else if (med.today_status === 'Missed') {
                                      bgClass = "bg-red-500/5 border-red-500/20 hover:border-red-500/40";
                                      statusText = "Missed";
                                      iconClass = "fa-times-circle text-red-400";
                                  }
                              %>
                                  <div class="glass p-5 rounded-2xl border border-white/5 transition flex flex-col sm:flex-row sm:items-center justify-between gap-4 <%= bgClass %>">
                                      <div class="flex items-start gap-4">
                                          <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-cyan-400 text-md shrink-0">
                                              <i class="fas <%= med.time_of_day === 'Night' ? 'fa-moon' : (med.time_of_day === 'Morning' ? 'fa-sun' : 'fa-pills') %>"></i>
                                          </div>
                                          <div>
                                              <div class="flex items-center gap-2">
                                                  <h4 class="font-bold text-white text-sm"><%= med.medicine_name %></h4>
                                                  <span class="px-2 py-0.5 text-[9px] font-bold uppercase rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20"><%= med.time_of_day %></span>
                                              </div>
                                              <p class="text-xs text-gray-400 mt-1 font-mono"><%= med.dosage %> &bull; <%= med.relation_to_food %></p>
                                          </div>
                                      </div>

                                      <div class="flex items-center gap-4">
                                          <div class="flex items-center gap-1.5 text-xs">
                                              <i class="far <%= iconClass %>"></i>
                                              <span class="font-bold uppercase tracking-wider text-[10px] <%= med.today_status === 'Taken' ? 'text-green-400' : (med.today_status === 'Missed' ? 'text-red-400' : 'text-gray-400') %>"><%= statusText %></span>
                                          </div>

                                          <div class="flex items-center gap-2">
                                              <form method="POST" action="/patient/medicines" class="inline-flex gap-1 bg-white/5 border border-white/10 p-1 rounded-xl">
                                                  <input type="hidden" name="medicine_id" value="<%= med.id %>">
                                                  <button type="submit" name="log_intake" value="Taken" title="Mark Taken" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-green-500/20 text-green-400 transition">
                                                      <i class="fas fa-check"></i>
                                                  </button>
                                                  <button type="submit" name="log_intake" value="Missed" title="Mark Missed" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-red-500/20 text-red-400 transition">
                                                      <i class="fas fa-times"></i>
                                                  </button>
                                                  <% if (med.today_status) { %>
                                                      <button type="submit" name="log_intake" value="Reset" title="Clear status" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-500/20 text-gray-400 transition">
                                                          <i class="fas fa-undo"></i>
                                                      </button>
                                                  <% } %>
                                              </form>
                                              
                                              <a href="/patient/medicines?delete_id=<%= med.id %>" onclick="return confirm('Remove this routine schedule?')" title="Delete Routine" class="w-8 h-8 flex items-center justify-center rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 hover:bg-red-500/20 transition text-xs">
                                                  <i class="fas fa-trash-alt"></i>
                                              </a>
                                          </div>
                                      </div>
                                  </div>
                              <% }) %>
                          </div>
                      <% } %>
                  </div>
              </div>
          </div>

      </div>

    </main>

  </div>
</body>
</html>
