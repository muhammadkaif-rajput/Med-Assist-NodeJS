<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Diabetes Risk Assessment | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255,255,255,0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(56,189,248,0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(6,182,212,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">

  <div class="fixed top-0 left-0 w-[50%] h-[50%] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 right-0 w-[50%] h-[50%] rounded-full bg-purple-600/10 blur-[150px] pointer-events-none z-0"></div>

  <!-- NAV -->
  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-heartbeat text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">

    <!-- SIDEBAR -->
    <%- include('../includes/sidebar-patient', { activePage: 'diabetes-predict' }) %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 space-y-6">

      <!-- HEADER -->
      <div class="glass p-6 rounded-3xl relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 to-blue-600"></div>
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl shadow-[inset_0_0_10px_rgba(6,182,212,0.2)]">
            <i class="fas fa-dna"></i>
          </div>
          <div>
            <h1 class="text-xl font-bold text-white">Diabetes Risk Assessment</h1>
            <p class="text-xs text-gray-400 mt-1">Enter your health metrics to assess your diabetes risk using AI</p>
          </div>
        </div>
      </div>

      <!-- ERROR MESSAGE -->
      <% if (message) { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 px-4 py-3 rounded-xl text-sm font-bold flex items-center shadow-[0_0_15px_rgba(239,68,68,0.2)]">
          <i class="fas fa-exclamation-triangle mr-2 text-red-400"></i> <%= message %>
        </div>
      <% } %>

      <!-- RESULT CARD -->
      <% if (result) { %>
        <% if (result.prediction === 1) { %>
          <!-- HIGH RISK -->
          <div class="glass p-6 rounded-3xl border border-red-500/30 shadow-[0_0_30px_rgba(239,68,68,0.15)] relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 to-orange-500"></div>
            <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
              <div class="w-24 h-24 rounded-3xl bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-400 text-4xl shadow-[inset_0_0_20px_rgba(239,68,68,0.2)] shrink-0">
                <i class="fas fa-exclamation-triangle"></i>
              </div>
              <div class="flex-1 text-center md:text-left">
                <p class="text-[10px] font-bold text-red-400 uppercase tracking-widest mb-2">Assessment Result</p>
                <h2 class="text-2xl font-extrabold text-white mb-2">⚠️ High Risk Detected</h2>
                <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
                  <span class="text-sm text-gray-400">Risk Probability:</span>
                  <span class="text-2xl font-extrabold text-red-400"><%= (result.probability * 100).toFixed(1) %>%</span>
                </div>
                <!-- Progress bar -->
                <div class="w-full bg-white/10 rounded-full h-3 mb-4">
                  <div class="bg-gradient-to-r from-red-500 to-orange-500 h-3 rounded-full shadow-[0_0_10px_rgba(239,68,68,0.5)] transition-all" style="width: <%= (result.probability * 100).toFixed(1) %>%"></div>
                </div>
                <p class="text-sm text-gray-300 mb-4">Based on the provided health metrics, there is a <strong class="text-red-400">high risk</strong> of diabetes. Please consult a healthcare professional for a comprehensive diagnosis.</p>
                <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                  <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-lg border bg-red-500/20 border-red-500/30 text-red-300">⚠️ High Risk</span>
                  <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-lg border bg-amber-500/20 border-amber-500/30 text-amber-300">Consult a Doctor</span>
                </div>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- LOW RISK -->
          <div class="glass p-6 rounded-3xl border border-green-500/30 shadow-[0_0_30px_rgba(34,197,94,0.15)] relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-green-500 to-cyan-500"></div>
            <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
              <div class="w-24 h-24 rounded-3xl bg-green-500/20 border border-green-500/30 flex items-center justify-center text-green-400 text-4xl shadow-[inset_0_0_20px_rgba(34,197,94,0.2)] shrink-0">
                <i class="fas fa-check-circle"></i>
              </div>
              <div class="flex-1 text-center md:text-left">
                <p class="text-[10px] font-bold text-green-400 uppercase tracking-widest mb-2">Assessment Result</p>
                <h2 class="text-2xl font-extrabold text-white mb-2">✅ Low Risk Detected</h2>
                <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
                  <span class="text-sm text-gray-400">Risk Probability:</span>
                  <span class="text-2xl font-extrabold text-green-400"><%= (result.probability * 100).toFixed(1) %>%</span>
                </div>
                <!-- Progress bar -->
                <div class="w-full bg-white/10 rounded-full h-3 mb-4">
                  <div class="bg-gradient-to-r from-green-500 to-cyan-500 h-3 rounded-full shadow-[0_0_10px_rgba(34,197,94,0.5)] transition-all" style="width: <%= (result.probability * 100).toFixed(1) %>%"></div>
                </div>
                <p class="text-sm text-gray-300 mb-4">Your health metrics suggest a <strong class="text-green-400">low risk</strong> of diabetes at this time. Keep maintaining a healthy lifestyle!</p>
                <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                  <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-lg border bg-green-500/20 border-green-500/30 text-green-300">✅ Low Risk</span>
                  <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-lg border bg-cyan-500/20 border-cyan-500/30 text-cyan-300">Stay Healthy!</span>
                </div>
              </div>
            </div>
          </div>
        <% } %>
        <!-- Disclaimer -->
        <div class="bg-amber-500/10 border border-amber-500/20 text-amber-300/80 px-4 py-3 rounded-xl text-xs flex items-start gap-2">
          <i class="fas fa-info-circle mt-0.5 shrink-0"></i>
          <span>This is an AI-powered screening tool and is <strong>not a substitute</strong> for professional medical advice. Always consult a qualified healthcare provider for diagnosis and treatment.</span>
        </div>
      <% } %>

      <!-- FORM -->
      <div class="glass p-6 rounded-3xl">
        <h2 class="font-bold text-white text-sm uppercase tracking-widest mb-6 flex items-center gap-2">
          <i class="fas fa-clipboard-list text-cyan-400"></i>
          <%= result ? 'Try Again — Enter New Values' : 'Enter Your Health Metrics' %>
        </h2>
        <form method="POST" action="/patient/diabetes-predict" class="space-y-4">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pregnancies <span class="text-gray-600">(0 if male)</span></label>
              <input type="number" name="pregnancies" min="0" max="20" value="0"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Glucose Level <span class="text-gray-600">(mg/dL)</span></label>
              <input type="number" name="glucose" min="0" max="500" value="100"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Blood Pressure <span class="text-gray-600">(mm Hg)</span></label>
              <input type="number" name="bp" min="0" max="200" value="70"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Skin Thickness <span class="text-gray-600">(mm)</span></label>
              <input type="number" name="skin" min="0" max="100" value="20"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Insulin Level <span class="text-gray-600">(µU/mL)</span></label>
              <input type="number" name="insulin" min="0" max="900" value="79"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">BMI <span class="text-gray-600">(Body Mass Index)</span></label>
              <input type="number" step="0.1" name="bmi" min="0" max="70" value="25"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Diabetes Pedigree Function</label>
              <input type="number" step="0.01" name="dpf" min="0" max="3" value="0.47"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Age <span class="text-gray-600">(years)</span></label>
              <input type="number" name="age" min="1" max="120" value="30"
                class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-sm transition" required>
            </div>

          </div>

          <div class="pt-4 flex justify-center">
            <button type="submit"
              class="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold py-3 px-10 rounded-xl shadow-[0_0_20px_rgba(6,182,212,0.4)] transition text-sm uppercase tracking-widest flex items-center gap-2">
              <i class="fas fa-search"></i> Assess Risk
            </button>
          </div>

        </form>
      </div>

    </main>
  </div>
</body>
</html>
