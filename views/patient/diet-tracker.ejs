<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Diet & Water Tracker | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); }
    
    /* Water wave styling */
    .water-container {
        position: relative;
        width: 140px;
        height: 220px;
        border: 4px solid rgba(255, 255, 255, 0.15);
        border-top: none;
        border-radius: 0 0 35px 35px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.03);
        box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    }
    .water-fluid {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(180deg, #22d3ee, #0284c7);
        transition: height 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .water-wave-anim {
        position: absolute;
        width: 250px;
        height: 250px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 38%;
        top: -240px;
        left: -50px;
        animation: rotateWave 6s linear infinite;
        pointer-events: none;
    }
    .water-wave-anim-back {
        position: absolute;
        width: 260px;
        height: 260px;
        background: rgba(6, 182, 212, 0.25);
        border-radius: 40%;
        top: -245px;
        left: -55px;
        animation: rotateWave 8s linear infinite reverse;
        pointer-events: none;
    }
    @keyframes rotateWave {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 left-0 w-[50%] h-[50%] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 right-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-glass-water text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-patient') %>

    <!-- RIGHT CONTENT -->
    <main class="flex-1 space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
              <h2 class="text-2xl font-extrabold text-white">Diet & Water Intake</h2>
              <p class="text-xs text-gray-400 mt-1">Review personalized diet charts and log daily water metrics.</p>
          </div>
      </div>

      <% if (message) { %>
          <div class="bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-info-circle mr-2"></i> <%= message %>
          </div>
      <% } %>
      <% if (error) { %>
          <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
          </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- WATER TRACKER MODULE (COL-5) -->
          <div class="lg:col-span-5 glass p-6 rounded-3xl border border-white/5 shadow-lg flex flex-col items-center justify-between gap-6 min-h-[450px]">
              <div class="text-center w-full">
                  <h3 class="text-md font-bold text-white tracking-wide"><i class="fas fa-glass-water text-cyan-400 mr-2"></i>Water intake tracker</h3>
                  <p class="text-[10px] text-gray-500 mt-1 uppercase tracking-widest">Target: <%= waterGoal %> ml / Day</p>
              </div>

              <!-- Animated beaker visualization -->
              <div class="water-container">
                  <div class="water-fluid" style="height: <%= waterPct %>%;">
                      <div class="water-wave-anim"></div>
                      <div class="water-wave-anim-back"></div>
                  </div>
                  
                  <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-20">
                      <span class="font-bold text-3xl font-mono text-white drop-shadow-[0_4px_6px_rgba(0,0,0,0.8)]"><%= waterToday %></span>
                      <span class="text-[10px] font-bold text-cyan-100 uppercase tracking-widest drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">ml logged</span>
                  </div>
              </div>

              <div class="w-full space-y-4">
                  <!-- Quick logs -->
                  <form method="POST" action="/patient/diet-tracker" class="grid grid-cols-3 gap-2">
                      <button type="submit" name="log_water" value="250" class="bg-white/5 hover:bg-cyan-500/20 hover:text-cyan-300 border border-white/10 rounded-xl py-2.5 text-xs font-bold transition">
                          +250 ml
                      </button>
                      <button type="submit" name="log_water" value="500" class="bg-white/5 hover:bg-cyan-500/20 hover:text-cyan-300 border border-white/10 rounded-xl py-2.5 text-xs font-bold transition">
                          +500 ml
                      </button>
                      <button type="submit" name="log_water" value="1000" class="bg-white/5 hover:bg-cyan-500/20 hover:text-cyan-300 border border-white/10 rounded-xl py-2.5 text-xs font-bold transition">
                          +1000 ml
                      </button>
                  </form>

                  <!-- Reset -->
                  <form method="POST" action="/patient/diet-tracker">
                      <button type="submit" name="reset_water" value="1" onclick="return confirm('Clear today\'s water log?')" class="w-full bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-red-400 font-bold py-2.5 rounded-xl transition text-xs uppercase tracking-widest">
                          Reset intake
                      </button>
                  </form>
              </div>
          </div>

          <!-- DIET ADVICE MODULE (COL-7) -->
          <div class="lg:col-span-7 space-y-6">
              <h3 class="text-lg font-bold text-white tracking-wide"><i class="fas fa-apple-whole text-emerald-400 mr-2"></i>Personalized diet suggestions</h3>
              
              <div class="grid gap-4">
                  <% dietAdvice.forEach(function(advice) { 
                      let alertColor = "border-white/10 bg-white/5 text-cyan-400";
                      let cardColor = "bg-white/5 border border-white/10";
                      let tagColor = "bg-white/10 border-white/20 text-gray-300";

                      if (advice.color === 'red') {
                          cardColor = "bg-red-500/5 border border-red-500/20";
                          alertColor = "text-red-400";
                          tagColor = "bg-red-500/10 border-red-500/20 text-red-400";
                      } else if (advice.color === 'amber') {
                          cardColor = "bg-amber-500/5 border border-amber-500/20";
                          alertColor = "text-amber-400";
                          tagColor = "bg-amber-500/10 border-amber-500/20 text-amber-400";
                      } else if (advice.color === 'green') {
                          cardColor = "bg-emerald-500/5 border border-emerald-500/20";
                          alertColor = "text-emerald-400";
                          tagColor = "bg-emerald-500/10 border-emerald-500/20 text-emerald-400";
                      } else if (advice.color === 'blue') {
                          cardColor = "bg-blue-500/5 border border-blue-500/20";
                          alertColor = "text-blue-400";
                          tagColor = "bg-blue-500/10 border-blue-500/20 text-blue-400";
                      }
                  %>
                      <div class="p-6 rounded-3xl transition relative group overflow-hidden <%= cardColor %>">
                          <div class="flex justify-between items-start mb-4">
                              <h4 class="font-bold text-md text-white flex items-center gap-2">
                                  <i class="fas <%= advice.icon %> <%= alertColor %>"></i> <%= advice.title %>
                              </h4>
                              <span class="px-2.5 py-0.5 rounded border text-[9px] font-bold uppercase tracking-widest <%= tagColor %>"><%= advice.type %></span>
                          </div>
                          <p class="text-xs text-gray-400 leading-relaxed"><%= advice.desc %></p>
                      </div>
                  <% }) %>
              </div>
          </div>

      </div>

    </main>

  </div>
</body>
</html>
