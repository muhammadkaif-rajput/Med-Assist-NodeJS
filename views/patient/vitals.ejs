<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Vitals Log | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; } .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(6,182,212,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 left-0 w-[50%] h-[50%] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 right-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-heartbeat text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-patient') %>

    <!-- RIGHT CONTENT -->
    <main class="flex-1 space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
              <h2 class="text-2xl font-extrabold text-white">Daily Vitals Log</h2>
              <p class="text-xs text-gray-400 mt-1">Track and monitor your daily key health vitals.</p>
          </div>
      </div>

      <% if (message) { %>
          <div class="bg-green-500/10 border border-green-500/30 text-green-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-check-circle mr-2"></i> <%= message %>
          </div>
      <% } %>
      <% if (error) { %>
          <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-2xl text-xs font-semibold shadow-sm">
              <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
          </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- LOG FORM -->
          <div class="space-y-6">
              <div class="glass p-6 rounded-3xl border border-white/5 shadow-lg space-y-6">
                  <div>
                      <h3 class="text-md font-bold text-white tracking-wide"><i class="fas fa-plus-circle text-cyan-400 mr-2"></i>Log Vitals</h3>
                      <p class="text-[10px] text-gray-500 mt-1 uppercase tracking-widest">Enter today's readings</p>
                  </div>

                  <form method="POST" action="/patient/vitals" class="space-y-4">
                      <div>
                          <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Blood Pressure (mmHg)</label>
                          <input type="text" name="blood_pressure" placeholder="e.g. 120/80" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                      </div>
                      <div>
                          <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Blood Sugar (mg/dL)</label>
                          <input type="number" step="0.1" name="blood_sugar" placeholder="e.g. 95.5" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                      </div>
                      <div>
                          <div class="flex justify-between items-center mb-1.5">
                              <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest">Heart Rate (bpm)</label>
                              <button type="button" onclick="openHeartRateScanner()" class="text-[9px] bg-cyan-500/20 hover:bg-cyan-500/40 border border-cyan-500/50 text-cyan-300 font-bold px-2 py-0.5 rounded transition uppercase tracking-widest"><i class="fas fa-camera mr-1"></i> Scan pulse</button>
                          </div>
                          <input type="number" name="heart_rate" placeholder="e.g. 72" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                      </div>
                      <div>
                          <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Weight (kg)</label>
                          <input type="number" step="0.1" name="weight" placeholder="e.g. 70.0" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                      </div>
                      <div>
                          <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1.5">Temperature (°F)</label>
                          <input type="number" step="0.1" name="temperature" placeholder="e.g. 98.6" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-cyan-500 outline-none text-xs transition">
                      </div>

                      <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold py-3 rounded-xl transition text-xs uppercase tracking-widest shadow-[0_0_15px_rgba(6,182,212,0.3)]">
                          Save Log
                      </button>
                  </form>
              </div>

              <!-- GUIDELINES CARD -->
              <div class="glass p-5 rounded-3xl border border-white/5 space-y-4">
                  <h4 class="text-xs font-bold text-white uppercase tracking-widest flex items-center gap-2"><i class="fas fa-info-circle text-cyan-400"></i> How to Measure?</h4>
                  <ul class="text-[11px] text-gray-400 space-y-2.5 font-sans leading-relaxed">
                      <li><strong class="text-cyan-400">Blood Pressure:</strong> Wrap a BP cuff around your upper arm, sit still, and enter the numbers shown (systolic/diastolic).</li>
                      <li><strong class="text-cyan-400">Blood Sugar:</strong> Use a glucometer with a fresh test strip. Fasting normal is 70-100 mg/dL.</li>
                      <li><strong class="text-cyan-400">Heart Rate:</strong> Click <span class="text-cyan-300 font-semibold cursor-pointer underline" onclick="openHeartRateScanner()">Scan pulse</span> to read it instantly using your device's webcam, or enter manually.</li>
                      <li><strong class="text-cyan-400">Weight & Temp:</strong> Use a digital scale and home thermometer.</li>
                  </ul>
              </div>
          </div>

          <!-- LOG LIST -->
          <div class="lg:col-span-2 space-y-6">
              <div class="glass rounded-3xl overflow-hidden border border-white/5 shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
                  <div class="px-6 py-5 border-b border-white/10 bg-white/5 flex justify-between items-center">
                      <h3 class="font-bold text-white tracking-wide"><i class="fas fa-history text-cyan-400 mr-2"></i>History Log</h3>
                      <span class="text-[10px] text-gray-500 uppercase tracking-widest font-mono"><%= vitalLogs.length %> Entries</span>
                  </div>
                  <div class="overflow-x-auto scrollbar-thin">
                      <% if (vitalLogs.length === 0) { %>
                          <div class="p-12 text-center text-gray-500 text-xs font-mono">No vitals logged yet. Use the form to start tracking!</div>
                      <% } else { %>
                          <table class="w-full text-left text-xs whitespace-nowrap">
                              <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                                  <tr>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Date/Time</th>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">BP</th>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Sugar</th>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Heart Rate</th>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Weight</th>
                                      <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Temp</th>
                                  </tr>
                              </thead>
                              <tbody class="divide-y divide-white/5">
                                  <% vitalLogs.forEach(function(log) { %>
                                  <tr class="hover:bg-white/5 transition">
                                      <td class="px-6 py-4 text-white font-mono"><%= log.logged_at.toISOString().replace('T', ' ').substring(0, 16) %></td>
                                      <td class="px-6 py-4">
                                          <% 
                                            let bp = log.blood_pressure;
                                            if (!bp) { %>
                                                <span class="text-gray-600">-</span>
                                            <% } else {
                                                let bpParts = bp.split('/');
                                                let sys = parseInt(bpParts[0]) || 120;
                                                let dia = parseInt(bpParts[1]) || 80;
                                                let clr = "text-green-400";
                                                if (sys >= 140 || dia >= 90) clr = "text-red-400 font-bold";
                                                else if (sys >= 120 || dia >= 80) clr = "text-amber-400";
                                            %>
                                                <span class="font-mono <%= clr %>"><%= bp %> <span class="text-[10px] text-gray-500">mmHg</span></span>
                                            <% } %>
                                      </td>
                                      <td class="px-6 py-4">
                                          <% 
                                            let bs = log.blood_sugar;
                                            if (bs === null) { %>
                                                <span class="text-gray-600">-</span>
                                            <% } else {
                                                let clr = (bs > 140 || bs < 70) ? "text-red-400 font-bold" : "text-green-400";
                                            %>
                                                <span class="font-mono <%= clr %>"><%= parseFloat(bs) %> <span class="text-[10px] text-gray-500">mg/dL</span></span>
                                            <% } %>
                                      </td>
                                      <td class="px-6 py-4">
                                          <% 
                                            let hr = log.heart_rate;
                                            if (hr === null) { %>
                                                <span class="text-gray-600">-</span>
                                            <% } else {
                                                let clr = (hr > 100 || hr < 60) ? "text-red-400 font-bold" : "text-green-400";
                                            %>
                                                <span class="font-mono <%= clr %>"><%= parseInt(hr) %> <span class="text-[10px] text-gray-500">bpm</span></span>
                                            <% } %>
                                      </td>
                                      <td class="px-6 py-4 text-gray-300 font-mono">
                                          <%- log.weight !== null ? parseFloat(log.weight) + " <span class='text-[10px] text-gray-500'>kg</span>" : '<span class="text-gray-600">-</span>' %>
                                      </td>
                                      <td class="px-6 py-4">
                                          <% 
                                            let temp = log.temperature;
                                            if (temp === null) { %>
                                                <span class="text-gray-600">-</span>
                                            <% } else {
                                                let clr = (temp >= 99.5) ? "text-red-400 font-bold" : "text-green-400";
                                            %>
                                                <span class="font-mono <%= clr %>"><%= parseFloat(temp) %> <span class="text-[10px] text-gray-500">°F</span></span>
                                            <% } %>
                                      </td>
                                  </tr>
                                  <% }) %>
                              </tbody>
                          </table>
                      <% } %>
                  </div>
              </div>
          </div>

      </div>

    </main>

  </div>

  <!-- Scanner Modal Backdrop -->
  <div id="scannerModal" class="fixed inset-0 z-50 bg-[#070b14]/90 backdrop-blur-md hidden items-center justify-center p-4">
      <div class="glass w-full max-w-md rounded-3xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 space-y-6 relative overflow-hidden text-center">
          <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-cyan-500 to-blue-600"></div>
          
          <div class="flex justify-between items-center text-left">
              <div>
                  <h3 class="text-md font-bold text-white tracking-wide"><i class="fas fa-heartbeat text-cyan-400 mr-1.5"></i>Webcam Pulse Scanner</h3>
                  <p class="text-[10px] text-gray-500 mt-0.5">Real-time photoplethysmography (PPG)</p>
              </div>
              <button type="button" onclick="closeHeartRateScanner()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:bg-white/10 transition">
                  <i class="fas fa-times"></i>
              </button>
          </div>

          <!-- Scan Circle Area -->
          <div class="flex flex-col items-center justify-center space-y-4">
              <div class="relative w-36 h-36 rounded-full overflow-hidden border-4 border-cyan-500/30 flex items-center justify-center bg-black shadow-[0_0_20px_rgba(6,182,212,0.2)]">
                  <!-- Video stream -->
                  <video id="webcamVideo" autoplay playsinline class="absolute inset-0 w-full h-full object-cover opacity-45"></video>
                  <!-- Circular red overlay / fingerprint visual -->
                  <div id="pulseTarget" class="absolute w-20 h-20 rounded-full border-2 border-red-500/50 bg-red-600/10 flex items-center justify-center transition-transform duration-100">
                      <i class="fas fa-fingerprint text-3xl text-red-500"></i>
                  </div>
                  <!-- Analysis Canvas (Hidden) -->
                  <canvas id="analysisCanvas" width="10" height="10" class="hidden"></canvas>
              </div>
              <div class="h-12 flex items-center justify-center">
                  <p id="scannerInstructions" class="text-xs text-amber-400 font-semibold max-w-xs mx-auto">Cover the camera lens completely with your fingertip.</p>
              </div>
          </div>

          <!-- BPM Display -->
          <div class="space-y-4">
              <div class="flex justify-around items-center bg-white/5 rounded-2xl p-4 border border-white/5">
                  <div>
                      <span class="text-[10px] text-gray-500 uppercase tracking-widest block mb-0.5">Signal Status</span>
                      <span id="pulseValue" class="font-mono text-xs text-gray-400">-</span>
                  </div>
                  <div class="h-8 w-px bg-white/10"></div>
                  <div>
                      <span class="text-[10px] text-gray-500 uppercase tracking-widest block mb-0.5">Live Pulse Rate</span>
                      <span class="font-bold font-mono text-2xl text-white"><span id="bpmValue">-</span> <span class="text-xs text-gray-500">BPM</span></span>
                  </div>
              </div>

              <!-- Progress Bar -->
              <div class="w-full bg-white/5 border border-white/10 rounded-full h-2 overflow-hidden">
                  <div id="scanProgressBar" class="bg-gradient-to-r from-cyan-500 to-blue-600 h-full w-0 transition-all duration-100"></div>
              </div>

              <div class="flex gap-3">
                  <button type="button" onclick="closeHeartRateScanner()" class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold py-2.5 rounded-xl transition text-xs uppercase tracking-widest">
                      Cancel
                  </button>
                  <button type="button" id="applyBpmBtn" disabled onclick="applyBPM()" class="flex-1 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold py-2.5 rounded-xl transition text-xs uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_0_15px_rgba(6,182,212,0.3)]">
                      Apply BPM
                  </button>
              </div>
          </div>
      </div>
  </div>

  <script>
      let videoStream = null;
      let animationFrameId = null;

      let signalValues = [];
      let signalTimes = [];
      const scanDuration = 12000; // 12 seconds scan to get a steady reading
      let scanStart = null;
      let scanInProgress = false;

      function openHeartRateScanner() {
          document.getElementById('scannerModal').classList.remove('hidden');
          document.getElementById('scannerModal').classList.add('flex');
          
          document.getElementById('bpmValue').innerText = '-';
          document.getElementById('pulseValue').innerText = '-';
          document.getElementById('scanProgressBar').style.width = '0%';
          document.getElementById('applyBpmBtn').disabled = true;
          document.getElementById('scannerInstructions').innerText = 'Initializing camera...';
          document.getElementById('scannerInstructions').className = 'text-xs text-gray-400';
          
          signalValues = [];
          signalTimes = [];
          scanInProgress = false;

          navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } })
              .then(stream => {
                  videoStream = stream;
                  const video = document.getElementById('webcamVideo');
                  video.srcObject = stream;
                  video.play();
                  startAnalysis();
              })
              .catch(err => {
                  document.getElementById('scannerInstructions').innerText = 'Camera access blocked or not found.';
                  document.getElementById('scannerInstructions').className = 'text-xs text-red-400 font-bold';
              });
      }

      function closeHeartRateScanner() {
          document.getElementById('scannerModal').classList.add('hidden');
          document.getElementById('scannerModal').classList.remove('flex');
          stopAnalysis();
      }

      function stopAnalysis() {
          if (animationFrameId) cancelAnimationFrame(animationFrameId);
          if (videoStream) {
              videoStream.getTracks().forEach(track => track.stop());
          }
          videoStream = null;
          scanInProgress = false;
      }

      function startAnalysis() {
          const video = document.getElementById('webcamVideo');
          const canvas = document.getElementById('analysisCanvas');
          const ctx = canvas.getContext('2d');
          
          function processFrame() {
              if (!videoStream) return;
              
              if (video.readyState === video.HAVE_ENOUGH_DATA) {
                  ctx.drawImage(video, 0, 0, 10, 10);
                  const imgData = ctx.getImageData(0, 0, 10, 10);
                  const data = imgData.data;
                  
                  let totalR = 0, totalG = 0, totalB = 0;
                  for (let i = 0; i < data.length; i += 4) {
                      totalR += data[i];
                      totalG += data[i+1];
                      totalB += data[i+2];
                  }
                  const count = data.length / 4;
                  const avgR = totalR / count;
                  const avgG = totalG / count;
                  
                  // PPG check: Skin covered back-lit webcam is highly saturated in Red
                  const isCovered = (avgR > 120) && (avgR / (avgG + 1) > 1.7);
                  
                  if (isCovered) {
                      document.getElementById('scannerInstructions').innerText = 'Lens covered. Keep your finger completely still...';
                      document.getElementById('scannerInstructions').className = 'text-xs text-green-400 font-semibold';
                      
                      const now = performance.now();
                      if (!scanInProgress) {
                          scanInProgress = true;
                          scanStart = now;
                      }
                      
                      const elapsed = now - scanStart;
                      const pct = Math.min(100, (elapsed / scanDuration) * 100);
                      document.getElementById('scanProgressBar').style.width = `${pct}%`;
                      
                      signalValues.push(avgR);
                      signalTimes.push(now);
                      
                      document.getElementById('pulseValue').innerText = `Capturing Signal`;
                      
                      // Calculate real-time estimate after 3 seconds of data
                      if (signalValues.length > 90) {
                          const bpmEstimate = calculateBPM();
                          if (bpmEstimate >= 50 && bpmEstimate <= 160) {
                              document.getElementById('bpmValue').innerText = bpmEstimate;
                              // Pulsing effect synced with heart rate if valid
                              const pulsePeriod = 60000 / bpmEstimate;
                              const scale = 1 + 0.12 * Math.sin((elapsed / pulsePeriod) * 2 * Math.PI);
                              document.getElementById('pulseTarget').style.transform = `scale(${scale})`;
                          }
                      }
                      
                      if (elapsed >= scanDuration) {
                          const finalBpm = calculateBPM();
                          if (finalBpm >= 50 && finalBpm <= 160) {
                              document.getElementById('bpmValue').innerText = finalBpm;
                              document.getElementById('scannerInstructions').innerText = 'Measurement complete and applied!';
                              document.getElementById('scannerInstructions').className = 'text-xs text-green-400 font-bold';
                              document.getElementById('applyBpmBtn').disabled = false;
                              stopAnalysis();
                              return;
                          } else {
                              // unstable, extend scan
                              scanStart = now - 6000; // roll back to 50%
                              signalValues = signalValues.slice(-90);
                              signalTimes = signalTimes.slice(-90);
                          }
                      }
                  } else {
                      document.getElementById('scannerInstructions').innerText = 'Please place your fingertip fully over the camera lens.';
                      document.getElementById('scannerInstructions').className = 'text-xs text-amber-400 font-bold';
                      document.getElementById('pulseTarget').style.transform = 'scale(1)';
                      document.getElementById('pulseValue').innerText = 'No finger detected';
                      
                      scanInProgress = false;
                      signalValues = [];
                      signalTimes = [];
                      document.getElementById('scanProgressBar').style.width = '0%';
                  }
              }
              
              animationFrameId = requestAnimationFrame(processFrame);
          }
          
          animationFrameId = requestAnimationFrame(processFrame);
      }

      function calculateBPM() {
          if (signalValues.length < 30) return 0;
          
          // Subtractive moving average filter (high pass) to clean baseline drift
          const windowSize = 6;
          const filtered = [];
          for (let i = windowSize; i < signalValues.length - windowSize; i++) {
              let sum = 0;
              for (let j = -windowSize; j <= windowSize; j++) {
                  sum += signalValues[i + j];
              }
              const movingAvg = sum / (2 * windowSize + 1);
              filtered.push({ val: signalValues[i] - movingAvg, time: signalTimes[i] });
          }
          
          // Peak picker
          let peaks = [];
          for (let i = 2; i < filtered.length - 2; i++) {
              const curr = filtered[i].val;
              if (curr > filtered[i-1].val && curr > filtered[i-2].val && 
                  curr > filtered[i+1].val && curr > filtered[i+2].val && curr > 0.05) {
                  
                  if (peaks.length === 0 || (filtered[i].time - peaks[peaks.length - 1].time) > 380) {
                      peaks.push({ time: filtered[i].time });
                  }
              }
          }
          
          if (peaks.length < 2) return 0;
          
          const diffs = [];
          for (let i = 1; i < peaks.length; i++) {
              diffs.push(peaks[i].time - peaks[i-1].time);
          }
          const avgDiff = diffs.reduce((a, b) => a + b, 0) / diffs.length;
          return Math.round(60000 / avgDiff);
      }

      function applyBPM() {
          const bpm = document.getElementById('bpmValue').innerText;
          if (bpm !== '-') {
              document.querySelector('input[name="heart_rate"]').value = bpm;
          }
          closeHeartRateScanner();
      }
  </script>
</body>
</html>
