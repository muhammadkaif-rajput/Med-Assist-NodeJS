<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Appointments | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; } .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(6,182,212,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 right-0 w-[50%] h-[50%] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-heartbeat text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-patient') %>

    <main class="flex-1">
      <div class="glass rounded-3xl border border-white/5 overflow-hidden shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
        <div class="px-6 py-5 border-b border-white/10 bg-white/5 flex justify-between items-center">
          <h2 class="font-bold text-white tracking-wide">Appointment Logs</h2>
        </div>
        <div class="p-0">
          <% if (appointments.length === 0) { %>
              <div class="p-12 text-center text-gray-500 text-sm">You have no booked appointments.</div>
          <% } else { %>
               <table class="w-full text-left text-sm whitespace-nowrap">
                   <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                       <tr>
                           <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Doctor</th>
                           <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Date & Time</th>
                           <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400">Status</th>
                           <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-cyan-400 text-right">Details</th>
                       </tr>
                   </thead>
                   <tbody class="divide-y divide-white/5">
                       <% appointments.forEach(function(a) { %>
                       <tr class="hover:bg-white/5 transition">
                           <td class="px-6 py-5 text-white font-bold tracking-wide">
                               Dr. <%= a.doctor_name %>
                               <span class="block mt-1 text-[10px] uppercase tracking-widest font-mono text-gray-500"><%= a.specialization %></span>
                           </td>
                           <td class="px-6 py-5 text-gray-400 font-mono text-xs"><%= a.appointment_date.toISOString().slice(0, 10) %></td>
                           <td class="px-6 py-5">
                               <% 
                                   let stl = "bg-white/5 text-gray-400 border-white/10";
                                   if(a.status === 'Pending') stl = "bg-amber-500/20 text-amber-400 border-amber-500/30 shadow-[0_0_10px_rgba(245,158,11,0.2)]";
                                   else if(a.status === 'Confirmed') stl = "bg-cyan-500/20 text-cyan-400 border-cyan-500/30 shadow-[0_0_10px_rgba(6,182,212,0.2)]";
                                   else if(a.status === 'Completed') stl = "bg-green-500/20 text-green-400 border-green-500/30 shadow-[0_0_10px_rgba(34,197,94,0.2)]";
                                   else if(a.status === 'Cancelled') stl = "bg-red-500/20 text-red-400 border-red-500/30";
                               %>
                               <span class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-lg border <%= stl %>"><%= a.status %></span>
                           </td>
                           <td class="px-6 py-5 text-right">
                                <% if (a.status === 'Completed') { %>
                                    <div class="flex justify-end gap-2">
                                        <button onclick="openViewModal('<%= a.appointment_id %>', 'Dr. <%= a.doctor_name.replace(/'/g, "\\'") %>', '<%= (a.prescription || '').replace(/\r?\n/g, '\\n').replace(/'/g, "\\'") %>', '<%= (a.doctor_notes || '').replace(/\r?\n/g, '\\n').replace(/'/g, "\\'") %>')" class="text-[10px] bg-cyan-500/20 hover:bg-cyan-500/40 border border-cyan-500/50 text-cyan-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest">
                                            <i class="fas fa-eye mr-1"></i>View
                                        </button>
                                        <a href="/patient/print-prescription?id=<%= a.appointment_id %>" target="_blank" class="text-[10px] bg-emerald-500/20 hover:bg-emerald-500/40 border border-emerald-500/50 text-emerald-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest inline-flex items-center">
                                            <i class="fas fa-print mr-1"></i>Print
                                        </a>
                                    </div>
                                <% } else { %>
                                    <span class="text-xs text-gray-500 font-mono italic">No record</span>
                                <% } %>
                            </td>
                       </tr>
                       <% }) %>
                   </tbody>
               </table>
            <% } %>
         </div>
       </div>
     </main>

  </div>

  <!-- Modal Backdrop -->
  <div id="viewModal" class="fixed inset-0 z-50 bg-[#070b14]/85 backdrop-blur-md hidden items-center justify-center p-4">
      <div class="glass w-full max-w-lg rounded-3xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 space-y-6 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-cyan-500 to-blue-600"></div>
          <div class="flex justify-between items-center">
              <div>
                  <h3 class="text-lg font-bold text-white tracking-wide">Medical Prescription</h3>
                  <p class="text-xs text-cyan-400 mt-1">Doctor: <span id="modal_doctor_name" class="font-bold text-white"></span></p>
              </div>
              <button onclick="closeViewModal()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:bg-white/10 transition">
                  <i class="fas fa-times"></i>
              </button>
          </div>
          <div class="space-y-4">
              <div class="bg-white/5 border border-white/5 p-4 rounded-2xl">
                  <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-2"><i class="fas fa-prescription-bottle-medical mr-1.5"></i>Prescription (Medicines & Dosage)</p>
                  <p id="modal_prescription" class="text-sm text-gray-200 leading-relaxed font-mono whitespace-pre-wrap"></p>
              </div>

              <div class="bg-white/5 border border-white/5 p-4 rounded-2xl">
                  <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-2"><i class="fas fa-file-medical mr-1.5"></i>Doctor Notes & Advice</p>
                  <p id="modal_notes" class="text-sm text-gray-200 leading-relaxed whitespace-pre-wrap"></p>
              </div>

              <div class="pt-2 flex gap-3">
                  <a id="modal_print_btn" href="#" target="_blank" class="flex-1 bg-emerald-500/20 hover:bg-emerald-500/40 border border-emerald-500/50 text-emerald-300 text-center font-bold py-3 rounded-xl transition text-xs uppercase tracking-widest inline-flex items-center justify-center gap-1.5">
                      <i class="fas fa-print"></i> Print PDF
                  </a>
                  <button type="button" onclick="closeViewModal()" class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold py-3 rounded-xl transition text-xs uppercase tracking-widest">
                      Close
                  </button>
              </div>
          </div>
      </div>
  </div>

  <script>
  function openViewModal(id, doctorName, prescription, notes) {
      document.getElementById('modal_doctor_name').innerText = doctorName;
      document.getElementById('modal_prescription').innerText = prescription ? prescription : 'No prescription entered.';
      document.getElementById('modal_notes').innerText = notes ? notes : 'No notes or advice entered.';
      document.getElementById('modal_print_btn').href = '/patient/print-prescription?id=' + id;
      document.getElementById('viewModal').classList.remove('hidden');
      document.getElementById('viewModal').classList.add('flex');
  }

  function closeViewModal() {
      document.getElementById('viewModal').classList.add('hidden');
      document.getElementById('viewModal').classList.remove('flex');
  }
  </script>

</body>
</html>
