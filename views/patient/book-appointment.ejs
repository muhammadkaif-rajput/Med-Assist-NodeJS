<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Book Appointment | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(59, 130, 246, 0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; } .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(59,130,246,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 left-[20%] w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-blue-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-heartbeat text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-cyan-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-patient') %>

    <main class="flex-1">
      <div class="max-w-2xl">
          <div class="glass p-8 md:p-10 rounded-3xl relative overflow-hidden border border-white/5 shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
            <div class="absolute top-0 right-0 w-1 h-full bg-blue-500"></div>
            
            <h2 class="text-2xl font-extrabold text-white mb-2">Book an Appointment</h2>
            <p class="text-sm text-gray-400 mb-8 max-w-xl">Select a doctor and preferred date to book your appointment below.</p>
            
            <% if (message) { %>
                <div class="bg-blue-500/20 border border-blue-500/30 text-blue-300 p-4 rounded-xl text-sm mb-8 flex items-center shadow-[0_0_15px_rgba(59,130,246,0.2)] backdrop-blur-sm">
                    <i class="fas fa-check-circle mr-3 text-lg"></i> <span class="font-bold"><%= message %></span>
                </div>
            <% } %>

            <form method="POST" action="/patient/book-appointment">
                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Select Doctor</label>
                    <div class="relative">
                        <select name="doctor_id" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-4 flex-1 px-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-sm appearance-none cursor-pointer" required>
                            <option value="" class="bg-gray-800 text-gray-500">-- Choose Specialist --</option>
                            <% doctors.forEach(function(doc) { %>
                                <option value="<%= doc.id %>" class="bg-gray-800 font-bold">
                                    Dr. <%= doc.name %> (<%= doc.specialization %>)
                                </option>
                            <% }) %>
                        </select>
                        <i class="fas fa-chevron-down absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 pointer-events-none"></i>
                    </div>
                </div>

                <div class="mb-8">
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Date and Time</label>
                    <input type="datetime-local" name="appointment_date" class="w-full bg-white/5 border border-white/10 text-white rounded-xl py-4 px-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-sm uppercase" required>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-400 hover:to-cyan-400 text-white font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(59,130,246,0.4)] transition text-sm uppercase tracking-widest">
                    Confirm Booking
                </button>
            </form>
          </div>
      </div>
    </main>

  </div>
</body>
</html>
