<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Appointments | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(168, 85, 247, 0.5); }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 right-0 w-[60%] h-[60%] rounded-full bg-purple-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 left-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-purple-500 to-indigo-600 text-white shadow-[0_0_15px_rgba(168,85,247,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-stethoscope text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-purple-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-doctor') %>

    <main class="flex-1 space-y-8">
      
        <% if (message) { %>
            <div class="bg-purple-500/20 border border-purple-500/30 text-purple-300 p-4 rounded-xl text-sm flex items-center shadow-[0_0_10px_rgba(168,85,247,0.2)] backdrop-blur-sm">
                <i class="fas fa-info-circle mr-2"></i> <%= message %>
            </div>
        <% } %>

        <div class="glass rounded-3xl border border-white/5 overflow-hidden shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
            <div class="px-6 py-5 border-b border-white/10 bg-white/5 flex justify-between items-center">
            <h2 class="font-bold text-white text-sm uppercase tracking-widest">Appointments List</h2>
            </div>
            <div class="p-0">
                <% if (appointments.length === 0) { %>
                    <div class="p-12 text-center text-gray-500 text-sm font-mono">No appointments found.</div>
                <% } else { %>
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                            <tr>
                                <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Patient</th>
                                <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Date & Time</th>
                                <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Status</th>
                                <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            <% appointments.forEach(function(a) { %>
                            <tr class="hover:bg-white/5 transition">
                                <td class="px-6 py-5 text-white font-bold">
                                    <div class="flex items-center gap-2">
                                        <span><%= a.patient_name %></span>
                                        <a href="/doctor/patient-history?id=<%= a.patient_user_id %>" class="text-[9px] bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 text-purple-400 font-bold px-2 py-0.5 rounded transition uppercase tracking-widest" title="View Medical History"><i class="fas fa-history mr-1"></i>History</a>
                                    </div>
                                    <span class="block mt-1 font-mono text-[10px] tracking-widest text-gray-500"><%= a.age %> Yrs • <%= a.gender %></span>
                                </td>
                                <td class="px-6 py-5 text-gray-400 font-mono text-xs"><%= a.appointment_date.toISOString().slice(0, 10) %></td>
                                <td class="px-6 py-5">
                                    <% 
                                        let stl = "bg-white/5 text-gray-400 border-white/10";
                                        if(a.status === 'Pending') stl = "bg-amber-500/20 text-amber-400 border-amber-500/30 shadow-[0_0_10px_rgba(245,158,11,0.2)]";
                                        else if(a.status === 'Confirmed') stl = "bg-blue-500/20 text-blue-400 border-blue-500/30 shadow-[0_0_10px_rgba(59,130,246,0.2)]";
                                        else if(a.status === 'Completed') stl = "bg-green-500/20 text-green-400 border-green-500/30 shadow-[0_0_10px_rgba(34,197,94,0.2)]";
                                        else if(a.status === 'Cancelled') stl = "bg-red-500/20 text-red-400 border-red-500/30";
                                    %>
                                    <span class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-lg border <%= stl %>"><%= a.status %></span>
                                </td>
                                <td class="px-6 py-5 text-right w-48">
                                    <% if (a.status === 'Pending') { %>
                                        <div class="flex gap-2 justify-end">
                                            <form method="POST" action="/doctor/appointments">
                                                <input type="hidden" name="appointment_id" value="<%= a.appointment_id %>">
                                                <button type="submit" name="action" value="Confirmed" class="text-[10px] bg-blue-500/20 hover:bg-blue-500/40 border border-blue-500/50 text-blue-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest">Accept</button>
                                            </form>
                                            <form method="POST" action="/doctor/appointments">
                                                <input type="hidden" name="appointment_id" value="<%= a.appointment_id %>">
                                                <button type="submit" name="action" value="Cancelled" class="text-[10px] bg-red-500/20 hover:bg-red-500/40 border border-red-500/50 text-red-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest">Deny</button>
                                            </form>
                                        </div>
                                    <% } else if (a.status === 'Confirmed') { %>
                                        <div class="flex justify-end">
                                            <button type="button" onclick="openCompleteModal(<%= a.appointment_id %>, '<%= a.patient_name.replace(/'/g, "\\'") %>')" class="text-[10px] bg-green-500/20 hover:bg-green-500/40 border border-green-500/50 text-green-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest"><i class="fas fa-check mr-1"></i>Complete</button>
                                        </div>
                                    <% } else if (a.status === 'Completed') { %>
                                        <div class="flex justify-end">
                                            <button type="button" onclick="openCompleteModal(<%= a.appointment_id %>, '<%= a.patient_name.replace(/'/g, "\\'") %>', '<%= (a.prescription || '').replace(/\r?\n/g, '\\n').replace(/'/g, "\\'") %>', '<%= (a.doctor_notes || '').replace(/\r?\n/g, '\\n').replace(/'/g, "\\'") %>', false, true)" class="text-[10px] bg-purple-500/15 hover:bg-purple-500/30 border border-purple-500/20 text-purple-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest"><i class="fas fa-edit mr-1"></i>Edit Notes</button>
                                        </div>
                                    <% } else { %>
                                        <span class="text-[10px] uppercase tracking-widest text-gray-600 font-mono">Done</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

    </main>

  </div>

  <!-- Modal Backdrop -->
  <div id="completeModal" class="fixed inset-0 z-50 bg-[#070b14]/85 backdrop-blur-md hidden items-center justify-center p-4">
      <div class="glass w-full max-w-lg rounded-3xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 space-y-6 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-purple-500 to-indigo-600"></div>
          <div class="flex justify-between items-center">
              <div>
                  <h3 id="modal_title" class="text-lg font-bold text-white tracking-wide">Complete Appointment</h3>
                  <p class="text-xs text-purple-400 mt-1">Patient: <span id="complete_patient_name" class="font-bold text-white"></span></p>
              </div>
              <button onclick="closeCompleteModal()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:bg-white/10 transition">
                  <i class="fas fa-times"></i>
              </button>
          </div>
          <form method="POST" action="/doctor/appointments" class="space-y-4">
              <input type="hidden" name="appointment_id" id="complete_appointment_id">
              <input type="hidden" name="action" id="modal_action" value="Completed">
              <input type="hidden" name="update_prescription" id="modal_update_prescription" value="0">
              
              <div>
                  <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Prescription (Medicines & Dosage)</label>
                  <textarea name="prescription" id="prescription_field" rows="3" class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-3 px-4 focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none transition text-sm" placeholder="e.g. Paracetamol 500mg - 1 Tablet morning & night for 3 days."></textarea>
              </div>

              <div>
                  <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Doctor Notes & Advice</label>
                  <textarea name="doctor_notes" id="notes_field" rows="3" class="w-full bg-[#0e172a] border border-white/10 text-white rounded-xl py-3 px-4 focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none transition text-sm" placeholder="e.g. Avoid cold drinks. Complete bed rest for 2 days."></textarea>
              </div>

              <div class="flex gap-3 pt-2">
                  <button type="button" onclick="closeCompleteModal()" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-bold py-3 rounded-xl border border-white/10 transition text-xs uppercase tracking-widest">
                      Cancel
                  </button>
                  <button type="submit" id="modal_submit_btn" class="flex-1 bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white font-bold py-3 rounded-xl shadow-[0_0_15px_rgba(168,85,247,0.4)] transition text-xs uppercase tracking-widest">
                      Save
                  </button>
              </div>
          </form>
      </div>
  </div>

  <script>
  function openCompleteModal(appointmentId, patientName, prescription = '', notes = '', isReadOnly = false, isUpdateMode = false) {
      document.getElementById('complete_appointment_id').value = appointmentId;
      document.getElementById('complete_patient_name').innerText = patientName;
      document.getElementById('prescription_field').value = prescription;
      document.getElementById('notes_field').value = notes;
      
      const submitBtn = document.getElementById('modal_submit_btn');
      const modalTitle = document.getElementById('modal_title');
      const actionInput = document.getElementById('modal_action');
      const updateInput = document.getElementById('modal_update_prescription');
      
      if (isUpdateMode) {
          actionInput.disabled = true;
          updateInput.value = "1";
          modalTitle.innerText = "Edit Prescription & Notes";
      } else {
          actionInput.disabled = false;
          updateInput.value = "0";
          modalTitle.innerText = "Complete Appointment";
      }
      
      if (isReadOnly) {
          document.getElementById('prescription_field').readOnly = true;
          document.getElementById('notes_field').readOnly = true;
          submitBtn.style.display = 'none';
      } else {
          document.getElementById('prescription_field').readOnly = false;
          document.getElementById('notes_field').readOnly = false;
          submitBtn.style.display = 'block';
      }
      
      document.getElementById('completeModal').classList.remove('hidden');
      document.getElementById('completeModal').classList.add('flex');
  }

  function closeCompleteModal() {
      document.getElementById('completeModal').classList.add('hidden');
      document.getElementById('completeModal').classList.remove('flex');
  }
  </script>

</body>
</html>
