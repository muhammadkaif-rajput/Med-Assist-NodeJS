<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Patients Directory | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(168, 85, 247, 0.5); }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 right-0 w-[60%] h-[60%] rounded-full bg-purple-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 left-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-purple-500 to-indigo-600 text-white shadow-[0_0_15px_rgba(168,85,247,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-stethoscope text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-purple-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-doctor') %>

    <main class="flex-1 space-y-8">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
              <h2 class="text-2xl font-extrabold text-white">Patients Directory</h2>
              <p class="text-xs text-gray-400 mt-1">Search patients and view their detailed medical histories.</p>
          </div>
          <form method="GET" action="/doctor/patients" class="flex gap-2">
              <input type="text" name="search" value="<%= search %>" placeholder="Search name, phone, email..." class="bg-white/5 border border-white/10 text-white rounded-xl py-2 px-4 focus:ring-2 focus:ring-purple-500 outline-none text-xs w-64 transition">
              <button type="submit" class="bg-purple-600 hover:bg-purple-500 text-white font-bold px-4 py-2 rounded-xl transition text-xs uppercase tracking-widest">Search</button>
          </form>
      </div>

      <div class="glass rounded-3xl overflow-hidden border border-white/5 shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
          <div class="p-0">
              <% if (patients.length === 0) { %>
                  <div class="p-12 text-center text-gray-500 text-sm font-mono">No patients found.</div>
              <% } else { %>
                  <table class="w-full text-left text-sm whitespace-nowrap">
                      <thead class="bg-white/5 border-b border-white/10 text-gray-400">
                          <tr>
                              <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Name</th>
                              <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Contact Details</th>
                              <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400">Demographics</th>
                              <th class="px-6 py-4 font-bold text-[10px] uppercase tracking-widest text-purple-400 text-right">Actions</th>
                          </tr>
                      </thead>
                      <tbody class="divide-y divide-white/5">
                          <% patients.forEach(function(p) { %>
                          <tr class="hover:bg-white/5 transition">
                              <td class="px-6 py-5 text-white font-bold">
                                  <%= p.name %>
                              </td>
                              <td class="px-6 py-5 text-gray-400 text-xs font-mono">
                                  <div><i class="fas fa-phone mr-1.5 text-gray-600"></i><%= p.phone || 'N/A' %></div>
                                  <div class="mt-1"><i class="fas fa-envelope mr-1.5 text-gray-600"></i><%= p.email %></div>
                              </td>
                              <td class="px-6 py-5 text-gray-300 text-xs">
                                  <%= p.age %> Years • <%= p.gender %>
                              </td>
                              <td class="px-6 py-5 text-right">
                                  <a href="/doctor/patient-history?id=<%= p.id %>" class="inline-flex items-center gap-1.5 text-[10px] bg-purple-500/20 hover:bg-purple-500/40 border border-purple-500/50 text-purple-300 font-bold px-3 py-1.5 rounded-lg transition shadow-sm uppercase tracking-widest">
                                      <i class="fas fa-history"></i> Medical History
                                  </a>
                              </td>
                          </tr>
                          <% }) %>
                      </tbody>
                  </table>
              <% } %>
          </div>
      </div>

    </main>

  </div>
</body>
</html>
