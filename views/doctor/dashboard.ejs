<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Doctor Dashboard | MedAssist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); }
    .neon-text { text-shadow: 0 0 10px rgba(168, 85, 247, 0.5); }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; } .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(168,85,247,0.3); border-radius: 4px; }
  </style>
</head>
<body class="bg-[#0b1120] text-gray-200 antialiased min-h-screen relative overflow-x-hidden">
  
  <div class="fixed top-0 right-0 w-[60%] h-[60%] rounded-full bg-purple-600/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 left-0 w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none z-0"></div>

  <nav class="glass sticky top-0 z-50 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-purple-500 to-indigo-600 text-white shadow-[0_0_15px_rgba(168,85,247,0.4)] rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-stethoscope text-lg"></i>
        </div>
        <span class="font-bold text-xl tracking-wide text-white">Med<span class="text-purple-400 neon-text">Assist</span></span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/logout" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8 relative z-10">
    
    <!-- LEFT SIDEBAR -->
    <%- include('../includes/sidebar-doctor') %>

    <!-- RIGHT CONTENT -->
    <main class="flex-1 space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="glass p-6 rounded-3xl relative overflow-hidden flex items-center justify-between group">
          <div class="absolute inset-0 bg-gradient-to-r from-purple-500/10 to-transparent opacity-0 group-hover:opacity-100 transition duration-500"></div>
          <div class="relative z-10">
            <p class="text-[10px] font-bold text-purple-400 uppercase tracking-widest mb-2">Pending Appointments</p>
            <p class="text-4xl font-extrabold text-white"><%= pendingCount %></p>
          </div>
          <div class="relative z-10 w-14 h-14 bg-purple-500/20 border border-purple-500/30 rounded-2xl flex items-center justify-center text-purple-400 text-2xl shadow-[inset_0_0_10px_rgba(168,85,247,0.2)]">
            <i class="fas fa-user-clock"></i>
          </div>
        </div>
      </div>

      <div class="glass rounded-3xl overflow-hidden border border-white/5 shadow-[0_10px_40px_rgba(0,0,0,0.3)]">
        <div class="px-6 py-5 border-b border-white/10 bg-white/5 flex justify-between items-center">
          <h2 class="font-bold text-white tracking-wide">Recent Appointments</h2>
          <a href="/doctor/appointments" class="text-xs font-bold text-purple-400 hover:text-purple-300 uppercase tracking-widest">View All</a>
        </div>
        <div>
          <% if (recentAppointments.length === 0) { %>
              <div class="p-10 text-center text-gray-500 text-sm font-mono">No recent appointments.</div>
          <% } else { %>
              <div class="divide-y divide-white/5">
                  <% recentAppointments.forEach(function(a) { %>
                  <div class="p-5 px-6 flex justify-between items-center hover:bg-white/5 transition">
                      <div class="flex items-center gap-4">
                          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 font-bold uppercase">
                              <%= a.patient_name.charAt(0).toUpperCase() %>
                          </div>
                          <div>
                              <div class="flex items-center gap-2">
                                  <p class="text-sm font-bold text-white"><%= a.patient_name %></p>
                                  <a href="/doctor/patient-history?id=<%= a.patient_id %>" class="text-[9px] bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 text-purple-400 font-bold px-2 py-0.5 rounded transition uppercase tracking-widest" title="View Medical History"><i class="fas fa-history mr-1"></i>History</a>
                              </div>
                              <p class="text-[10px] text-gray-500 font-mono mt-0.5 uppercase tracking-widest"><%= a.age %> Yrs • <%= a.gender %> • <%= a.appointment_date.toISOString().slice(0, 10) %></p>
                          </div>
                      </div>
                      <div class="flex items-center gap-3">
                          <% 
                            let stl = "bg-white/5 text-gray-400 border-white/10";
                            if(a.status === 'Pending') stl = "bg-amber-500/20 text-amber-400 border-amber-500/30 shadow-[0_0_10px_rgba(245,158,11,0.2)]";
                            else if(a.status === 'Confirmed') stl = "bg-blue-500/20 text-blue-400 border-blue-500/30 shadow-[0_0_10px_rgba(59,130,246,0.2)]";
                            else if(a.status === 'Completed') stl = "bg-green-500/20 text-green-400 border-green-500/30 shadow-[0_0_10px_rgba(34,197,94,0.2)]";
                            else if(a.status === 'Cancelled') stl = "bg-red-500/20 text-red-400 border-red-500/30";
                          %>
                          <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-lg border <%= stl %>">
                              <%= a.status %>
                          </span>
                          <a href="/doctor/appointments" class="text-[10px] bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold px-2.5 py-1 rounded-lg transition uppercase tracking-widest" title="Manage Appointment"><i class="fas fa-cog"></i></a>
                      </div>
                  </div>
                  <% }) %>
              </div>
          <% } %>
        </div>
      </div>

    </main>

  </div>
</body>
</html>
